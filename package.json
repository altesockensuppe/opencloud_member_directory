{
  "name": "web-app-member-directory",
  "version": "0.1.0",
  "description": "Member directory for clubs and associations as an OpenCloud web app: manage members, share them, import CSV, export Excel/PDF/CSV",
  "license": "Apache-2.0",
  "author": "AlteSocke",
  "keywords": [
    "opencloud",
    "opencloud-web",
    "web-app",
    "member-directory",
    "club",
    "association"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm vite build",
    "build:w": "pnpm vite build --watch --mode development",
    "check:types": "vue-tsc --noEmit",
    "lint": "eslint 'src/**/*.{js,ts,vue}' --color",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "test:unit": "NODE_OPTIONS=--unhandled-rejections=throw vitest"
  },
  "devDependencies": {
    "@opencloud-eu/eslint-config": "~4.2.0",
    "@opencloud-eu/prettier-config": "~4.2.0",
    "@opencloud-eu/tsconfig": "~4.2.0",
    "@opencloud-eu/web-client": "~4.2.0",
    "@opencloud-eu/web-pkg": "~4.2.0",
    "@opencloud-eu/extension-sdk": "~4.2.0",
    "@types/node": "^22.13.10",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.22.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.2",
    "vite": "^7.0.0",
    "vitest": "^3.0.9",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^3.0.0",
    "vue3-gettext": "^2.4.0"
  },
  "packageManager": "pnpm@11.27.0",
  "dependencies": {
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "write-excel-file": "^4.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
